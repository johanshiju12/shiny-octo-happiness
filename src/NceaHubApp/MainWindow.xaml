<Window
    x:Class="NceaHubApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NCEA Hub"
    Height="600"
    Width="900">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="Welcome to NCEA Hub" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Your personalized dashboard for NCEA progress." FontSize="16" />
            <Button Content="Get Started" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
